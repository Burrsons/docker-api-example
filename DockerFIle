# Small official Python image
FROM python:3.12-slim

# Don't write .pyc files, and print logs immediately
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy requirements first: Docker caches this layer, so packages
# are only reinstalled when requirements.txt changes
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Then the code
COPY api/ .

# Run as a normal user, not root (same idea as the deploy user)
RUN useradd --create-home appuser
USER appuser

EXPOSE 8000

# 0.0.0.0 inside the container, so Docker can forward traffic to it
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
